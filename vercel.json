{
  "version": 2,
  "builds": [
    { "src": "src/pages/api/book-consultation.ts", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/book-consultation", "dest": "/src/pages/api/book-consultation" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
} 